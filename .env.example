# Copia este archivo como .env (que git ignora) y pon tu clave real ahí, nunca aquí.
# La clave se crea en https://console.anthropic.com → API keys. Pon un tope de gasto en
# Settings → Limits (por ejemplo, US$ 5 al mes).
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Modelo que interpreta las preguntas y redacta el párrafo (opcional).
CIFRALISTA_MODELO=claude-haiku-5-5

# Tope de consultas con IA por sesión del navegador (opcional; protege el gasto en la URL pública).
CIFRALISTA_MAX_CONSULTAS_IA=25
